{
  "name": "spa2099-hr-health",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "lint:css": "stylelint \"shared/**/*.css\" \"*.css\"",
    "lint:html": "htmlhint \"*.html\" \"docs/**/*.html\"",
    "brand-check": "node scripts/brand-check.js",
    "lint": "npm run lint:css && npm run lint:html && npm run brand-check",
    "build:ts": "tsc && tsc-alias",
    "test:unit": "vitest run --coverage",
    "test": "playwright test",
    "storybook:build": "storybook build --quiet",
    "build": "npm run build:ts",
    "preview": "node scripts/preview-server.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.3.3",
    "@storybook/react": "^8.3.3",
    "@storybook/react-vite": "^8.3.3",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@playwright/test": "^1.48.0",
    "@vitest/coverage-v8": "^2.1.1",
    "htmlhint": "^1.1.4",
    "husky": "^9.0.0",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.4.5",
    "vitest": "^2.1.1"
  }
}
