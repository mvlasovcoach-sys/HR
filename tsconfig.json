{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Node",
    "moduleDetection": "force",
    "baseUrl": "./src",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["*"]
    },
    "rootDir": "src",
    "outDir": "assets/js/modules",
    "declaration": true,
    "declarationDir": "types",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "assets", "tests", "public"]
}
